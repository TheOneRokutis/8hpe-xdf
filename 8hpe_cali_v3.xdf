<!-- Generated by e_work/tools/x3_build_xdf.py from the static RE of the ZF 8HP E-series (Bosch ITCU2, SH-2A) calibration. -->
<!-- PROVENANCE: Independently reverse-engineered descriptive metadata (addresses, data types, -->
<!-- scaling, and labels) for the ZF 8HP calibration, produced by the author from static analysis. -->
<!-- It contains NO vendor firmware, binary, or calibration data: it only describes where items sit -->
<!-- in a calibration image the user must supply separately. Author's own work product. -->
<XDFFORMAT version="1.70">
  <XDFHEADER>
    <flags>0x1</flags>
    <deftitle>ZF 8HP E-series TCU calibration (0x180200) - RE draft</deftitle>
    <description>Independently reverse-engineered descriptive metadata; contains no vendor binary data. Describes the E-series calibration image (0x7FE00 bytes at flash 0x180200-0x1FFFFF, big-endian), which the user must supply separately (bins/xhp_stage3_e_series.bin is offset 0x180200). Offsets in this XDF are file offsets; descriptions give the flash address (file offset + 0x180200). Values are raw. Built from static RE only: the confidence of every item is in its description. The three [PATCH] items apply byte edits (Stage 3 maps / Start in 2nd / True manual); apply them in that order. Checksums are NOT handled by this XDF - recompute the segment CRC after applying a patch. The calibration-ID / signature tail at 0x1FFD5C-0x1FFEDB is identification metadata and is deliberately not modelled.</description>
    <author>e_work/tools/x3_build_xdf.py</author>
    <BASEOFFSET offset="0" subtract="0" />
    <DEFAULTS datasizeinbits="16" sigdigits="2" outputtype="1" signed="0" lsbfirst="0" float="0" />
